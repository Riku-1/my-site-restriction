{
  "manifest_version": 3,
  "name": "Site Time Limit",
  "version": "1.5.0",
  "description": "サイトごとに1日の利用時間の上限を設定し、超えたら閲覧をブロックします",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "action": {
    "default_title": "Site Time Limit 設定"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["media.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "site-time-limit@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
